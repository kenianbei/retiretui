{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.md", "!!web"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "markdown": {
    "formatter": {
      "lineWidth": 80,
      "proseWrap": "always"
    }
  }
}
